# Metered — OVH production env. Copy to .env.production and fill in.
# NEVER commit .env.production (it holds secrets). Only this .example is tracked.
#
#   cp .env.production.example .env.production
#   # then edit the values below

# --- Public domain (DNS A-record must point at this VPS's IP) ---
DOMAIN=app.yourdomain.com

# --- Postgres (self-hosted in the db container) ---
# Superuser: admin/emergency only. The APP connects as the non-superuser
# 'metered_app' role using APP_DB_PASSWORD (created on first boot).
# Generate each: openssl rand -hex 24   (hex = SQL/URL-safe, no escaping issues)
POSTGRES_SUPER_PASSWORD=
APP_DB_PASSWORD=

# --- App secrets (production config refuses to boot if these are wrong) ---
# openssl rand -hex 32
JWT_SECRET=
# EXACTLY 64 hex chars: openssl rand -hex 32
# WARNING: losing/rotating this makes every stored portal credential
# undecryptable. Back it up in a password manager.
CRED_MASTER_KEY=

# OpenRouter key for AI bill extraction (OpenAI-compatible).
OPENROUTER_API_KEY=
# Optional; defaults to openai/gpt-4o-mini. Cheaper: google/gemini-2.0-flash-001
OPENROUTER_MODEL=openai/gpt-4o-mini
