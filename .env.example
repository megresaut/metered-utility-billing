# Metered — environment template. Copy to .env for local dev; in production set
# these in the host's secret store (Render dashboard), NOT in a committed file.

# --- Core ---
# development (default) or production. Production enables boot-time safety
# checks (see api/config/config.go Validate): rejects the dev JWT secret,
# requires CRED_MASTER_KEY, forbids sslmode=disable, requires the vars below.
APP_ENV=development

# Postgres. Local dev default shown; production must NOT use sslmode=disable.
DATABASE_URL=postgres://localhost:5432/utility_billing_platform_local?sslmode=disable

# Port (optional locally; Render injects its own PORT).
PORT=8090

# --- Secrets (required in production) ---
# Session token signing. Generate: openssl rand -hex 32
JWT_SECRET=

# AES-256 key for portal credential encryption. Exactly 64 hex chars.
# Generate: openssl rand -hex 32
# WARNING: losing/rotating this makes every stored portal credential
# undecryptable. Back it up in your secret manager.
CRED_MASTER_KEY=

# OpenRouter API key for PDF bill extraction (OpenAI-compatible API).
OPENROUTER_API_KEY=

# Extraction model (any OpenRouter model id). Default is a cheap, reliable
# choice; even cheaper options: google/gemini-2.0-flash-001,
# meta-llama/llama-3.3-70b-instruct. Optional; defaults to openai/gpt-4o-mini.
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- CORS (required in production) ---
# Comma-separated exact origins allowed to call the API from a browser. Set to
# the deployed frontend origin, e.g. https://app.yourdomain.com
# (Not needed if the frontend proxies /api server-side — see DEPLOY.md.)
CORS_ALLOWED_ORIGINS=http://localhost:5174
